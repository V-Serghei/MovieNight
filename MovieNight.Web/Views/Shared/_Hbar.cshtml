@using MovieNight.Domain.enams
@using MovieNight.Web.Infrastructure
@using MovieNight.Web.Models.PersonalP.Bookmark
@model dynamic

@{
var userModel = HttpContext.Current.GetMySessionObject();
var modelBookmark = HttpContext.Current.GetBookmarkTimeOf() as BookmarkTimeOf;
}

<div class="navbar-custom">
    <!-- ЛЕВАЯ ЧАСТЬ: Бургер + Логотип + Мегаменю -->
    <div class="topbar-left">
        <button class="button-menu-mobile waves-effect waves-light" type="button" aria-label="Toggle sidebar">
            <i class="fe-menu"></i>
        </button>

        <a href="@Url.Action("Index", "MainPage")" class="brand">
            <img src="/Client/images/logo.png" alt="MovieNight" />
        </a>

        <ul class="list-unstyled topnav-menu-left d-none d-lg-flex">
            <li class="dropdown dropdown-mega">
                <a class="dropdown-toggle waves-effect waves-light" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">
                    Mega Menu <i class="mdi mdi-chevron-down"></i>
                </a>
                <div class="dropdown-menu dropdown-megamenu">
                    <div class="row">
                        <div class="col-md-3">
                            <h5><i class="fe-film"></i>Movie</h5>
                            <ul class="megamenu-list">
                                <li><a href="@Url.Action("MovieSearch","SearchSortAdd")">Film page</a></li>
                                <li><a href="@Url.Action("CartoonsSearch","SearchSortAdd")">Cartoons page</a></li>
                                <li><a href="@Url.Action("AnimeSearch","SearchSortAdd")">Anime page</a></li>
                                <li><a href="@Url.Action("SerialsSearch","SearchSortAdd")">Serial page</a></li>
                            </ul>
                            <h5 class="mt-3"><i class="fe-tag"></i>Different</h5>
                            <ul class="megamenu-list">
                                <li><a href="@Url.Action("RandomFilm","SearchSortAdd")">Random movie</a></li>
                                @if (userModel != null) {
                                <li><a href="@Url.Action("ForYou","SearchSortAdd")">Movie For You</a></li>
                                }
                                <li><a href="@Url.Action("Novelty","SearchSortAdd")">Novelty</a></li>
                                <li><a href="@Url.Action("AreWatching","MainPage")">Are Watching</a></li>
                            </ul>
                        </div>

                        <div class="col-md-3">
                            <h5><i class="fe-anchor"></i>Information</h5>
                            <ul class="megamenu-list">
                                <li><a href="@Url.Action("Index","MainPage")">About us Pages</a></li>
                                <li><a href="@Url.Action("Primary","MainPage")">Primary</a></li>
                                <li><a href="@Url.Action("News","MainPage")">News</a></li>
                                <li><a href="@Url.Action("Top","MainPage")">Top</a></li>
                                <li><a href="@Url.Action("Calendar","Notification")">Calendar</a></li>
                            </ul>
                        </div>

                        @if (userModel != null) {
                        <div class="col-md-3">
                            <h5><i class="fe-user"></i>User panel</h5>
                            <ul class="megamenu-list">
                                <li><a href="@Url.Action("BookmarkPage","SearchSortAdd")">Bookmark Page</a></li>
                                <li><a href="@Url.Action("BookmarkTimeOfPage","SearchSortAdd")">Temporal bookmarks</a></li>
                                <li><a href="@Url.Action("ViewedList","SearchSortAdd")">Viewed List</a></li>
                                <li><a href="@Url.Action("PersonalPromotionStatistics","Statistic")">Personal Statistics</a></li>
                                <li><a href="@Url.Action("FriendsPage","SearchSortAdd")">Friends Page</a></li>
                                <li><a href="@Url.Action("FindFriends","SearchSortAdd")">Find Friends</a></li>
                                <li><a href="@Url.Action("Inbox","DataTransfer")">Inbox page</a></li>
                            </ul>
                        </div>
                        }

                        @if (userModel != null && (userModel.Role == LevelOfAccess.Moderator || userModel.Role == LevelOfAccess.Admin)) {
                        <div class="col-md-3">
                            <h5><i class="fe-server"></i>Admin mod</h5>
                            <ul class="megamenu-list">
                                <li><a href="@Url.Action("Index","Admin")">Add file</a></li>
                                <li><a href="@Url.Action("MovieTemplateEditing","InformationSynchronization")">Movie add</a></li>
                                <li><a href="#">Distribution of roles</a></li>
                                <li><a href="#">Review complaints</a></li>
                                <li><a href="#">Adding events</a></li>
                            </ul>
                        </div>
                        }
                    </div>
                </div>
            </li>
        </ul>
    </div>

    <!-- ЦЕНТР: ПОИСК -->
    <div class="topbar-center">
        <div class="search-wrap">
            @using (Ajax.BeginForm(
            "_SearchResultsPartial",
            "SearchSortAdd",
            new AjaxOptions {
            HttpMethod = "POST",
            OnSuccess = "handleSuccess",
            OnFailure = "handleFailure"
            },
            new { id = "searchForm", autocomplete = "off" }
            ))
            {
            <div class="app-search-box">
                <div class="input-group">
                    <input id="movieSearchInput"
                           name="searchTerm"
                           class="form-control"
                           placeholder="Search movies..."
                           type="text" />
                    <div class="input-group-append">
                        <button class="btn" type="submit">
                            <i class="fe-search"></i>
                        </button>
                    </div>
                </div>
            </div>
            }
            <div id="searchResults"></div>
        </div>
    </div>

    <!-- ПРАВАЯ ЧАСТЬ: Закладки + Профиль + Уведомления -->
    <div class="topbar-right">
        <!-- Закладки -->
        @if (userModel != null) {
        <div class="dropdown notification-list">
            <a class="nav-link dropdown-toggle waves-effect waves-light"
               data-toggle="dropdown"
               href="#"
               role="button"
               aria-haspopup="true"
               aria-expanded="false">
                <i class="remixicon-bookmark-3-line"></i>
                @if (modelBookmark != null && modelBookmark.Bookmark.Count > 0) {
                <span class="badge badge-danger noti-icon-badge">@modelBookmark.Bookmark.Count</span>
                }
            </a>
            <div class="dropdown-menu dropdown-menu-right dropdown-lg">
                <div class="dropdown-item noti-title">
                    <h5 class="m-0">
                        Bookmarks
                        <span class="float-right">
                                @Ajax.ActionLink(
                            "Clear All",
                            "ClearBookmarks",
                            "InformationSynchronization",
                            null,
                            new AjaxOptions { HttpMethod = "POST", OnSuccess = "clearBookmarksSuccess" },
                            new { @class = "text-dark" }
                            )
                            </span>
                    </h5>
                </div>

                @if (modelBookmark != null && modelBookmark.Bookmark.Count > 0) {
                <div class="slimscroll noti-scroll">
                    @{ modelBookmark.SortByTimeAdd(); }
                    @for (int i = 0; i < Math.Min(modelBookmark.Bookmark.Count, modelBookmark.MovieInTimeOfBookmark.Count); i++) {
                    var bookmark = modelBookmark.Bookmark.ElementAt(i);
                    var movie = modelBookmark.MovieInTimeOfBookmark.ElementAt(i);
                    <a href="@Url.Action("MovieTemplatePage", "InformationSynchronization", new { id = movie.Id })"
                       class="dropdown-item notify-item">
                        <div class="notify-icon">
                            <img src="@(string.IsNullOrEmpty(movie.PosterImage) ? "/Client/images/Movie/no_image.jpg" : Url.Content(movie.PosterImage))"
                                 alt="@movie.Title" />
                        </div>
                        <p class="notify-details">
                            @movie.Title
                            @{
                            var diff = DateTime.Now - bookmark.TimeAdd;
                            string timeAgo = diff.TotalMinutes < 1 ? "just now" :
                            diff.TotalHours < 1 ? $"{(int)diff.TotalMinutes} min ago" :
                            $"{(int)diff.TotalHours} hour ago";
                            }
                            <small class="text-muted">@timeAgo</small>
                        </p>
                    </a>
                    }
                </div>
                <a href="@Url.Action("BookmarkTimeOfPage", "SearchSortAdd")"
                   class="dropdown-item text-center notify-all">
                    View all <i class="fi-arrow-right"></i>
                </a>
                } else {
                <div class="dropdown-item text-center text-muted py-3">
                    No bookmarks yet
                </div>
                }
            </div>
        </div>
        }

        <!-- Профиль -->
        @if (userModel != null) {
        <div class="dropdown notification-list">
            <a class="nav-link dropdown-toggle nav-user waves-effect waves-light"
               data-toggle="dropdown"
               href="#"
               role="button"
               aria-haspopup="true"
               aria-expanded="false">
                <img src="@(string.IsNullOrEmpty(userModel.Avatar) ? "/Client/images/users/default_avatar.png" : Url.Content(userModel.Avatar))"
                     alt="@userModel.Username" />
                <span class="pro-user-name d-none d-sm-inline">
                        @userModel.Username <i class="mdi mdi-chevron-down"></i>
                    </span>
            </a>
            <div class="dropdown-menu dropdown-menu-right profile-dropdown">
                <div class="dropdown-header noti-title">
                    <h6 class="text-overflow m-0">Welcome!</h6>
                </div>
                <a href="@Url.Action("PersonalProfile", "InformationSynchronization")" class="dropdown-item">
                    <i class="mdi mdi-account-circle"></i> <span>My Account</span>
                </a>
                <a href="@Url.Action("ProfileEditing", "InformationSynchronization")" class="dropdown-item">
                    <i class="mdi mdi-settings"></i> <span>Settings</span>
                </a>
                <a href="@Url.Action("ViewedList", "SearchSortAdd")" class="dropdown-item">
                    <i class="remixicon-movie-2-line"></i> <span>Viewed List</span>
                </a>
                <a href="@Url.Action("PersonalPromotionStatistics", "Statistic")" class="dropdown-item">
                    <i class="remixicon-focus-2-fill"></i> <span>Statistics</span>
                </a>
                <div class="dropdown-divider"></div>
                <a href="@Url.Action("Logout", "Identification")" class="dropdown-item">
                    <i class="mdi mdi-logout"></i> <span>Logout</span>
                </a>
            </div>
        </div>
        } else {
        <a class="nav-link waves-effect waves-light" href="@Url.Action("Login", "Identification")">
            <i class="mdi mdi-login"></i>
            <span class="d-none d-sm-inline ml-1">Login</span>
        </a>
        }

        <!-- Уведомления -->
        <div class="dropdown notification-list">
            <a href="javascript:void(0);"
               class="nav-link right-bar-toggle waves-effect waves-light"
               title="Notifications">
                <i class="fe-bell noti-icon"></i>
                <span class="badge badge-danger noti-icon-badge" id="notificationCount"></span>
            </a>
        </div>
    </div>
</div>

<script>
    window.__urls = window.__urls || {};
    window.__urls.noImage = '@Url.Content("~/Client/images/Movie/no_image.jpg")';
    window.__urls.unreadCount = '@Url.Action("GetUnreadMessagesCount", "DataTransfer")';

    function clearBookmarksSuccess() {
        location.reload();
    }
</script>
