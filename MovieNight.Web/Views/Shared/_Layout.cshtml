@using System.Web.Optimization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>MovieNight | @ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="shortcut icon" href="/Client/images/logo.ico" />

    @* Базовые стили на всех страницах *@
    @Styles.Render("~/content/core")

    @* Стили конкретных страниц *@
    @RenderSection("PageStyles", required: false)
    @RenderSection("Styles", required: false) @* совместимость *@
</head>
<body>
<div id="wrapper">
    <div class="navbar-custom">
        @Html.Partial("_Hbar")
    </div>
    <div class="left-side-menu">
        @Html.Partial("_Lbar")
    </div>
    <div class="show">
        @Html.Partial("_AchievementL")
    </div>

    <div class="content-page">
        @RenderBody()
    </div>

    <footer id="footer" class="footer bg-dark text-white py-4">
        @Html.Partial("_Footer")
    </footer>

    <div class="right-bar">
        @Html.Partial("_Rbar")
    </div>

    @* Глобальные URL для JS (чтобы не городить инлайны в partial'ах) *@
    <script>
        window.__urls = {
            unreadCount: '@Url.Action("GetUnreadMessagesCount", "DataTransfer")',
            noImage: '@Url.Content("~/Client/images/Movie/no_image.jpg")'
        };
    </script>

    @* Ядро JS *@
    @Scripts.Render("~/bundles/core/js")
    @Scripts.Render("~/bundles/app/js")

    @* Инициализация шапки (вынос из _Hbar.cshtml) *@
    @Scripts.Render("~/bundles/hbar/js")
    <script>
      jQuery(function ($) {
        if ($.fn.dropdown) $('.dropdown-toggle').dropdown();
        // Диагностика: проверь, что события вообще летят
        // $(document).on('shown.bs.dropdown hidden.bs.dropdown', e => console.log(e.type, e.target));
      });
    </script>
    @* Скрипты конкретных страниц/фич *@
    @RenderSection("PageScripts", required: false)
    @RenderSection("scripts", required: false) @* совместимость *@

    
</div>
</body>
</html>
