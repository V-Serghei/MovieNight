# ============================================================
# MovieNight — Local Development Environment
# ============================================================
# Copy this file to .secrets.local and fill in the values.
# .secrets.local is gitignored and will be auto-generated
# by start-local.sh on first run.
# ============================================================

# SQL Server SA password (min 8 chars, must include uppercase, lowercase, number, symbol)
SA_PASSWORD=YourStrongPassword123!

# JWT signing secret (32+ random bytes, base64url encoded)
JWT_SECRET=replace-with-long-random-string-at-least-32-chars

# Gateway internal secret (for service-to-service auth)
GATEWAY_INTERNAL_SECRET=replace-with-another-long-random-string
